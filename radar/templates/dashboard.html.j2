<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name }} · {{ week }}</title>
<meta name="description" content="{{ brand.tagline_en }} A weekly radar of the power and infrastructure behind AI.">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%2322d3ee'/%3E%3Cstop offset='.55' stop-color='%233b82f6'/%3E%3Cstop offset='1' stop-color='%238b5cf6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='%2305080f'/%3E%3Cpath d='M35 8 15 36h15l-3 20 22-28H34l1-20z' fill='url(%23g)'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@500;600;700&display=swap" rel="stylesheet">
<script>{{ vendor_d3 }}</script>
<script>{{ vendor_topojson }}</script>
<style>
:root{--bg:#070b16;--panel:#0b1120;--line:#161c33;--line2:#232c4d;--fg:#eef1ff;--mute:#9da8c7;--dim:#7b86a8;
  --up:#2ee6a6;--down:#ff6b6b;--warn:#ffd166;--accent:#4d8dff;--blue:#4d8dff;--violet:#a78bfa;--violet2:#7c5cff;--cyan:#8ff0f4;--gen:#eef1ff;--load:#8ff0f4;
  --grad:linear-gradient(90deg,#a78bfa 0%,#7d9bff 50%,#8ff0f4 100%);
  --h0:#10162a;--h1:#152040;--h2:#1a2b5a;--h3:#203a79;--h4:#274b98;--h5:#2e5db8}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:var(--bg);font-size:14px;background-image:radial-gradient(900px 560px at 8% 0%,rgba(77,141,255,.26),transparent 60%),radial-gradient(700px 500px at 100% 100%,rgba(124,92,255,.10),transparent 60%),linear-gradient(rgba(148,163,184,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.04) 1px,transparent 1px);background-size:auto,auto,56px 56px,56px 56px;background-attachment:fixed;color:var(--fg);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:13px;line-height:1.5}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.mono{font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1440px;margin:0 auto;padding:0 28px 48px}
header{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px 24px;padding:22px 0 14px;border-bottom:1px solid var(--line2)}
header h1{margin:0;font-family:'IBM Plex Sans',Inter,sans-serif;font-size:18px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
header h1 .bolt{width:22px;height:22px;margin-right:10px;vertical-align:-5px}
header .tag{color:var(--mute);font-size:13px;font-style:italic}
header .ticker{margin-left:auto;display:flex;flex-wrap:wrap;gap:18px;font-size:12px;color:var(--mute);letter-spacing:.04em}
header .ticker b{color:var(--fg);font-weight:600}
.beta{display:none}
nav{display:flex;flex-wrap:wrap;gap:22px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:12px 0 0}
nav a{color:var(--mute);padding-bottom:3px}nav a:hover{color:var(--fg);text-decoration:none;border-bottom:1px solid var(--blue)}
.grid{display:grid;gap:22px;margin-top:22px}
.intro{display:flex;flex-direction:column;gap:8px;padding:30px 0 8px;max-width:900px}
.lead3{font-size:13px;color:var(--dim);font-style:italic}
.hero{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
@media (max-width:980px){.hero{grid-template-columns:minmax(0,1fr)}}
.hero .tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 20px}
.hero .map{min-height:0}
.gh{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
@media (max-width:980px){.hero,.gh{grid-template-columns:minmax(0,1fr)}}
.eyebrow{font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);font-weight:600}
.headline .rot{display:inline-block;vertical-align:bottom;text-align:left}
.headline .roll{display:grid}
.headline .roll span{grid-area:1/1;line-height:1.15em;white-space:nowrap;opacity:0;transform:translateY(.35em);transition:opacity .45s ease,transform .5s cubic-bezier(.65,0,.2,1);background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 8px rgba(124,92,255,.35)) drop-shadow(0 0 14px rgba(143,240,244,.22))}
.headline .roll span.on{opacity:1;transform:none}
.headline .roll span.off{opacity:0;transform:translateY(-.35em)}
@media (prefers-reduced-motion:reduce){.headline .roll span{transition:none}}
.headline{font-family:'IBM Plex Sans',Inter,sans-serif;font-size:32px;font-weight:700;letter-spacing:-.01em;line-height:1.05;color:var(--fg);padding-bottom:2px}
.headline .rot{text-transform:lowercase}
.lead{font-size:17px;color:var(--fg);font-weight:500}
.lead2{font-size:14px;color:var(--mute)}
#map .map{min-height:0}
#map.full{position:fixed;inset:0;z-index:50;border-radius:0;margin:0;padding:24px 32px;overflow:auto;background:var(--bg)}
#map.full .map{min-height:calc(100vh - 150px)}
#map.full .map svg{height:calc(100vh - 170px);width:100%}
.fsbtn{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);cursor:pointer;white-space:nowrap}
#totop{position:fixed;right:22px;bottom:22px;width:40px;height:40px;border-radius:20px;border:1px solid var(--line2);background:#0b1120ee;color:var(--fg);font-size:16px;cursor:pointer;display:none;align-items:center;justify-content:center;z-index:40;box-shadow:0 4px 18px rgba(0,0,0,.4)}
#totop:hover{border-color:var(--accent);color:var(--accent)}
#totop.show{display:flex}
html{scroll-behavior:smooth}
.glow{filter:url(#glow)}
.g2{grid-template-columns:minmax(0,7fr) minmax(0,5fr)}
.g2b{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
@media (max-width:980px){.g2,.g2b{grid-template-columns:minmax(0,1fr)}}
.panel{background:linear-gradient(180deg,rgba(255,255,255,.015),rgba(255,255,255,0)),var(--panel);border:1px solid var(--line);border-radius:8px;padding:22px 24px 24px;box-shadow:0 1px 0 rgba(255,255,255,.03) inset;min-width:0;display:flex;flex-direction:column;gap:16px}
.panel h2::before{content:'';display:inline-block;width:10px;height:10px;border-radius:2px;background:linear-gradient(135deg,var(--violet),var(--blue) 50%,var(--cyan));margin-right:12px;vertical-align:-1px}
.panel.foldable h2{cursor:pointer;user-select:none}
.panel.foldable h2::before{content:'';width:14px;height:12px;border-radius:0;background:linear-gradient(135deg,var(--violet),var(--blue) 50%,var(--cyan));clip-path:polygon(0 0,100% 0,50% 100%);margin-right:12px;vertical-align:-1px;transition:transform .15s}
.panel.foldable.fold h2::before{transform:rotate(-90deg)}
.panel.foldable h2:hover::before{background:var(--fg)}
.panel h2 .toggle{display:none}
.panel h2{margin:0;font-family:'IBM Plex Sans',Inter,sans-serif;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--fg);font-weight:700;display:flex;flex-wrap:wrap;align-items:baseline;gap:12px}
.panel h2 .sub{font-weight:400;text-transform:none;letter-spacing:0;color:var(--mute);font-size:13px}
.panel h2 .sub.mono{font-size:12px}
.panel h2 .right{margin-left:auto;display:flex;gap:16px}
.panel h2 .toggle:last-child{margin-left:auto}
.panel h2 .info{display:inline-block;width:14px;height:14px;border:1px solid var(--line2);border-radius:7px;color:var(--mute);font-size:9px;line-height:12px;text-align:center;cursor:help;font-weight:400;letter-spacing:0;vertical-align:1px}
.q{display:none;font-size:13px;color:var(--mute);line-height:1.5}
body.howto .q{display:block}
.howto-btn{margin-left:auto;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);cursor:pointer;border:1px solid var(--line2);border-radius:4px;padding:4px 10px;background:transparent;font-family:inherit}
body.howto .howto-btn{background:var(--accent);color:#06101f;border-color:var(--accent)}
.sub1{font-size:14px;color:var(--mute);padding:12px 0 0;max-width:820px;line-height:1.55}
.sub1 b{color:var(--fg);font-weight:500}
.heat .grp{grid-column:1 / -1;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);padding:8px 0 2px}
.about{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;font-size:13px;color:var(--mute);line-height:1.6}
.about b{display:block;color:var(--fg);font-weight:600;margin-bottom:4px}
@media (max-width:980px){.about{grid-template-columns:minmax(0,1fr)}}
.statline{display:flex;flex-wrap:wrap;gap:22px;font-size:13px;color:var(--mute)}
.statline b{color:var(--fg);font-weight:600}
.fact{position:relative;font-size:14px;color:var(--fg);border-left:0;background:linear-gradient(90deg,rgba(77,141,255,.07),transparent 60%);padding:4px 0 4px 14px;line-height:1.5}
.fact:empty{display:none}
.chip{border:0;background:transparent;padding:0 0 3px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);cursor:pointer;font-family:inherit}
.chip:hover{color:var(--fg)}
.chip.on{color:var(--fg);border-bottom:1px solid var(--blue)}
.panel h2 .sub{color:var(--blue);opacity:.9}
.tag{border:1px solid var(--line2);border-radius:2px;padding:0 6px;font-size:11px;color:var(--mute);letter-spacing:.02em;white-space:nowrap}
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 24px}
.tiles3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 24px}
@media (max-width:700px){.tiles,.tiles3{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 16px}}
.tile{position:relative;border-left:0;padding:2px 0 2px 14px;display:flex;flex-direction:column;gap:3px}
.tiles{gap:0 20px}
.tile .l{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute)}
.tile .v{font-size:38px;font-weight:700;line-height:1.05;letter-spacing:-.01em}
.tile .v small{font-size:14px;font-weight:400;color:var(--mute);margin-left:2px}
.tile .d{font-size:13px;color:var(--mute)}
.tile .d.up{color:var(--up)}.tile .d.down{color:var(--down)}.tile .d.flag{color:var(--violet)}
.tile .n{font-size:12px;color:var(--dim)}
.tile.hot .v{font-size:24px;line-height:1.3;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 8px rgba(124,92,255,.35))}
.tile.hot::before,.fact::before{content:'';position:absolute;left:0;top:2px;bottom:2px;width:2px;border-radius:1px;background:linear-gradient(180deg,#4d8dff,#8ff0f4);box-shadow:0 0 8px 1px rgba(77,141,255,.6)}
.tile{padding-left:0}
.tile.hot{padding-left:14px}
.tiles3 .tile .v{font-size:22px}
.heat{display:grid;grid-template-columns:150px repeat(8,minmax(0,1fr));gap:3px;font-size:11px;color:var(--mute);align-items:center}
.heat .wk{text-align:center;letter-spacing:.04em}
.heat .lay{cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:var(--mute);color:var(--mute);padding-right:6px}
.heat .lay:hover{color:var(--fg)}
.heat .c{height:24px;position:relative;display:flex;align-items:center;justify-content:center;font-size:11px;cursor:pointer}
.heat .c{border-radius:2px;color:#e6ecff;font-weight:500;text-shadow:none}
.heat .c[style*='--h5']{box-shadow:inset 0 0 0 1px rgba(143,240,244,.45)}
.heat .c:hover{box-shadow:inset 0 0 0 1px var(--blue)}
.heat .lgd{grid-column:1 / -1;display:flex;align-items:center;gap:6px;font-size:10px;color:var(--mute);padding-top:8px}
.heat .lgd i{display:inline-block;width:18px;height:6px;border-radius:1px}
.heat .c i{position:absolute;top:3px;right:3px;width:4px;height:4px;border-radius:2px;background:#d9b35a;font-size:0}
table{width:100%;border-collapse:collapse;font-size:13px}
th.sortable{cursor:pointer}th.sortable:hover,th.sortable.on{color:var(--fg)}
th{text-align:left;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);padding:6px 8px;border-bottom:1px solid var(--line2);font-weight:600}
td{padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.4}
td.mono:first-child{white-space:nowrap}
tr.row:hover td{background:#101a30}
tr.row{cursor:pointer}
tr.row.new td{background:#17150c}
td.what{color:var(--mute);font-size:13px}
.num{text-align:right;white-space:nowrap}
.imp{letter-spacing:1px;color:var(--fg);font-size:12px}
.imp .o{color:var(--line2)}
.map{position:relative;background:#070d19;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.map svg{display:block;width:100%;height:auto}
.legend{position:absolute;left:10px;bottom:8px;max-width:calc(100% - 20px);display:flex;flex-wrap:wrap;gap:1px 16px;font-size:11px;color:var(--mute);background:#0b1120d9;border-radius:4px;border:1px solid var(--line2);padding:5px 10px;line-height:1.6;letter-spacing:.02em;pointer-events:none;backdrop-filter:blur(4px)}
.legend .sw{display:inline-block;width:9px;height:9px;border-radius:5px;vertical-align:-1px;margin-right:5px}
.mapcount{position:absolute;left:10px;top:10px;font-size:10px;color:var(--mute);background:#0b1120cc;padding:3px 8px;border-radius:4px}
.zoomctl{position:absolute;right:10px;top:10px;display:flex;flex-direction:column;gap:4px}
.zoomctl button{width:30px;height:30px;border-radius:4px;border:1px solid var(--line2);background:#0b1120ee;color:var(--fg);font-size:15px;cursor:pointer}
.zoomctl button:hover{border-color:var(--cyan);color:var(--cyan)}
.tip .tt-h{font-weight:600;margin-bottom:4px;line-height:1.35}
.tip .tt-r{color:var(--fg)}
.tip .tt-m{color:var(--mute);font-size:11px;margin-top:4px}
.tip{position:fixed;pointer-events:none;background:#0b1120;border-radius:6px;border:1px solid var(--line2);color:var(--fg);padding:8px 10px;font-size:12px;max-width:320px;z-index:10;display:none;line-height:1.45}
.circuit{position:relative;min-height:420px;max-width:1100px;margin:0 auto;width:100%}
.clegend{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:11px;color:var(--mute);justify-content:center}
.clegend i{display:inline-block;vertical-align:middle;margin-right:6px}
.clegend .ln{width:26px;height:0;border-top:2px solid #3a4a6a}
.clegend .ln.dash{border-top-style:dashed}
.clegend .ln.new{border-top-color:var(--warn)}
.clegend .nd{width:16px;height:11px;border-radius:3px}
.clegend .nd.grad{background:linear-gradient(135deg,#5b3fd1,#2a5cd4)}
.clegend .nd.mid{background:#1a2439;border:1px solid var(--line2)}
.clegend .nd.sup{background:#0e1626;border:1px solid var(--accent)}
.circuit svg{display:block;width:100%;height:auto}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 24px}
@media (max-width:980px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
.card{border:1px solid var(--line);border-radius:6px;padding:12px 14px;display:flex;flex-direction:column;gap:5px;cursor:pointer;background:#0a1020}
.card:hover{border-color:var(--accent)}
.card .nm{display:flex;justify-content:space-between;gap:8px;font-weight:600;align-items:baseline}
.card .et{font-size:12px;color:var(--dim);letter-spacing:.02em}
.card .spark{display:flex;gap:2px;align-items:flex-end;height:18px}
.card .spark i{display:block;width:8px;background:var(--line2)}
.card .spark i.now{background:var(--blue);box-shadow:0 0 6px rgba(77,141,255,.8)}
.filters{display:flex;flex-wrap:wrap;gap:8px}
select,input{background:#070d19;color:var(--fg);border:1px solid var(--line2);border-radius:4px;padding:7px 10px;font-size:13px;font-family:inherit}
input{flex:1;min-width:200px}
.more{text-align:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);padding:10px;cursor:pointer}
.more:hover{color:var(--fg)}
.divider{text-align:center;font-size:11px;color:var(--mute);padding-top:14px;margin-top:28px;letter-spacing:.18em}
.panel.fold .body{display:none}
.panel.foldable .body{order:1}
.panel.foldable .regions{order:2}
.panel.foldable .fact{order:3}
.panel.foldable .q{order:0}
.panel.fold .fact{margin-top:-4px}
.panel h2 .toggle{margin-left:4px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);cursor:pointer;font-weight:500;white-space:nowrap}
.panel h2 .toggle::before{content:'▸ expand'}
.panel:not(.fold) h2 .toggle::before{content:'▾ collapse'}
.panel.fold .q{display:none}
footer{margin-top:40px;border-top:1px solid var(--line2);padding-top:12px;font-size:11px;color:var(--mute);display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}
.detail{font-size:13px;color:var(--mute);padding:4px 8px 12px 44px;line-height:1.5}
.stage0{opacity:.4}.stage1{opacity:.85}.stage2{opacity:1}
circle.approx{fill-opacity:.35 !important}
.panel h2 .leader{flex:1 1 20px;min-width:20px;border-top:1px dotted var(--line2);align-self:center;margin:0 6px}
.panel h2 .right{margin-left:0}
.panel h2 .toggle:last-child{margin-left:0}
td .vs-d{color:var(--cyan)}td .vs-r{color:var(--mute)}td .vs-e{color:var(--dim)}
@media (max-width:700px){
  .wrap{padding:0 16px 40px}
  header{padding:16px 0 10px;gap:8px 14px}
  header h1{font-size:16px}
  header .tag{display:none}
  header .ticker{margin-left:0;width:100%;gap:10px 14px;font-size:11px}
  header .ticker span:nth-child(2),header .ticker span:nth-child(3),header .ticker span:nth-child(4){display:none}
  nav{flex-wrap:nowrap;overflow-x:auto;gap:18px;padding:10px 0 6px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  nav::-webkit-scrollbar{display:none}
  nav a{white-space:nowrap;flex:none}
  .howto-btn{flex:none;margin-left:6px;padding:3px 8px;font-size:10px}
  .intro{padding:22px 0 4px}
  .headline{font-size:24px}
  .headline .rot{display:block}
  .lead{font-size:15px}
  .lead2{font-size:13px}
  .lead3{display:none}
  .grid{gap:14px;margin-top:14px}
  .panel{padding:16px 14px 16px;border-radius:6px}
  .panel h2{font-size:12px;letter-spacing:.1em;gap:8px}
  .panel h2 .leader{display:none}
  .panel h2 .sub{display:none}
  .panel h2 .right{width:100%;gap:12px;flex-wrap:wrap}
  .tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 12px}
  .tile{padding-left:10px}
  .tile .v{font-size:26px}
  .tile.hot .v{font-size:18px}
  .tile .n{display:none}
  .statline{gap:10px 16px;font-size:12px}
  .fact{font-size:13px}
  .hero .map,#map .map{min-height:0}
  .legend{position:static;max-width:none;margin-top:6px;border:0;background:transparent;padding:0;font-size:10px;gap:1px 12px;backdrop-filter:none}
  .mapcount{position:static;display:inline-block;margin-top:6px;font-size:9px;padding:2px 6px}
  .zoomctl{display:none}
  .fsbtn{display:none}
  .heat{grid-template-columns:96px repeat(8,minmax(0,1fr));gap:2px;font-size:10px}
  .heat .lay{font-size:11px}
  .heat .c{height:22px;font-size:10px}
  table{font-size:12px}
  th,td{padding:7px 5px}
  #dealtable th:nth-child(3),#dealtable td:nth-child(3){display:none}
  #feedtable th:nth-child(n+4),#feedtable td:nth-child(n+4){display:none}
  #feedtable td.detail{display:table-cell}
  .imp{font-size:10px;letter-spacing:0}
  .mtags .tag{margin-bottom:3px}
  .detail{padding-left:8px}
  .circuit,.clegend{display:none}
  body .clist{display:block}
  .clegend{font-size:10px;gap:6px 12px;justify-content:flex-start}
  .cards{grid-template-columns:minmax(0,1fr)}
  .filters select,.filters input{flex:1 1 45%;min-width:0}
  .about{gap:16px}
  #totop{right:14px;bottom:14px}
  #map.full{padding:12px}
}
.clist{display:none}
.clist .ci{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px}
.clist .ci .cv{font-size:11px;color:var(--mute);grid-column:1 / -1}
.clist .ci.new .cv b{color:var(--warn)}
#drawer{position:fixed;top:0;right:0;bottom:0;width:min(560px,100%);background:var(--panel);border-left:1px solid var(--line2);z-index:60;transform:translateX(100%);transition:transform .3s cubic-bezier(.65,0,.2,1);display:flex;flex-direction:column;box-shadow:-20px 0 60px rgba(0,0,0,.5)}
#drawer.open{transform:none}
#dmask{position:fixed;inset:0;background:rgba(3,6,12,.55);z-index:55;display:none}
#dmask.open{display:block}
#drawer .dh{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 8px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}
#drawer .dh button{background:transparent;border:1px solid var(--line2);color:var(--fg);border-radius:4px;width:30px;height:30px;cursor:pointer}
#drawer .dcount{padding:0 18px 10px;font-size:11px;color:var(--mute)}
#drawer .dbody{overflow:auto;flex:1;padding:0 18px}
#drawer .dfoot{padding:12px 18px;border-top:1px solid var(--line);font-size:12px}
#drawer table td:nth-child(n+4),#drawer table th:nth-child(n+4){display:none}
#drawer table td.detail{display:table-cell}
#drawer .mtags{display:block}
.mtags{display:none;margin-top:4px}
@media (max-width:700px){.mtags{display:block}}
abbr.t{text-decoration:none;border-bottom:1px dotted var(--blue);cursor:help}
td .vk{font-size:9px;color:var(--dim);letter-spacing:.04em;text-transform:uppercase;font-family:Inter,sans-serif}
.regions{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:12px;color:var(--mute)}
.regions b{color:var(--fg);font-weight:600}
.regions .r{display:flex;gap:8px;align-items:baseline}
.regions .r .mono{font-size:11px}
.introrow{display:flex;flex-wrap:wrap;gap:14px;align-items:center;padding-top:6px}
.wtf{background:transparent;border:1px solid var(--line2);color:var(--fg);border-radius:4px;padding:6px 12px;font-size:12px;font-family:inherit;cursor:pointer}
.wtf:hover{border-color:var(--blue)}
.tour-dim{position:fixed;inset:0;background:rgba(3,6,14,.66);z-index:60;display:none}
body.touring .tour-dim{display:block}
body.touring .panel.tour-on{position:relative;z-index:61;box-shadow:0 0 0 2px var(--cyan),0 0 44px rgba(143,240,244,.22)}
.tour-card{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);z-index:62;width:min(540px,calc(100% - 32px));background:var(--panel);border:1px solid var(--line2);border-radius:8px;padding:16px 18px 14px;box-shadow:0 14px 44px rgba(0,0,0,.55);display:none}
body.touring .tour-card{display:block;animation:tourin .35s ease}
@keyframes tourin{from{opacity:0;transform:translate(-50%,14px)}to{opacity:1;transform:translate(-50%,0)}}
.tour-card .k{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:600;margin-bottom:4px}
.tour-card h4{margin:0 0 6px;font-family:'IBM Plex Sans',Inter,sans-serif;font-size:17px;letter-spacing:.02em}
.tour-card p{margin:0 0 12px;font-size:13px;color:var(--mute);line-height:1.55}
.tour-card .row{display:flex;gap:8px;align-items:center}
.tour-card button{font-family:inherit;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-radius:4px;padding:6px 12px;cursor:pointer;border:1px solid var(--line2);background:transparent;color:var(--mute)}
.tour-card button:hover{border-color:var(--accent);color:var(--fg)}
.tour-card button.pri{background:var(--accent);color:#06101f;border-color:var(--accent)}
.tour-card button.skip{margin-left:auto}
.wtf.tourbtn{border-color:var(--accent);color:var(--accent)}
@media (prefers-reduced-motion:reduce){body.touring .tour-card{animation:none}}

.note-link{font-size:12px;color:var(--blue);border:1px solid rgba(77,141,255,.35);border-radius:4px;padding:6px 12px}
.note-link:hover{text-decoration:none;border-color:var(--blue);background:rgba(77,141,255,.08)}
.explain{display:none;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;font-size:13px;color:var(--mute);line-height:1.6;padding:14px 0 4px;max-width:1200px}
.explain.open{display:grid}
.explain b{display:block;color:var(--fg);font-weight:600;margin-bottom:4px}
@media (max-width:980px){.explain{grid-template-columns:minmax(0,1fr)}}
</style>
