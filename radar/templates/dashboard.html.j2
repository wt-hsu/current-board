<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name }} · {{ week }}</title>
<meta name="description" content="{{ brand.tagline_en }} A weekly radar of the power and infrastructure behind AI.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script>{{ vendor_d3 }}</script>
<script>{{ vendor_topojson }}</script>
<style>
:root{--bg:#090d16;--panel:#0f1626;--line:#1a2439;--line2:#273655;--fg:#eef2fb;--mute:#aab7cf;--dim:#8291ad;
  --up:#34d399;--down:#f87171;--warn:#f59e0b;--accent:#60a5fa;--blue:#3b82f6;--violet:#8b5cf6;--gen:#e8eefc;--load:#60a5fa;
  --h0:#0f1626;--h1:#13223d;--h2:#17315c;--h3:#1f4a8f;--h4:#2f6bd1;--h5:#60a5fa}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:var(--bg);font-size:14px;background-image:radial-gradient(1100px 650px at -8% -12%,rgba(59,130,246,.28),transparent 62%),radial-gradient(800px 600px at 108% 104%,rgba(139,92,246,.16),transparent 62%);background-attachment:fixed;color:var(--fg);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px;line-height:1.5}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
.mono{font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1440px;margin:0 auto;padding:0 28px 48px}
header{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px 24px;padding:22px 0 14px;border-bottom:1px solid var(--line2)}
header h1{margin:0;font-size:18px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
header h1 .mark{display:inline-block;width:9px;height:17px;background:linear-gradient(180deg,var(--blue),var(--violet));border-radius:2px;margin-right:12px;vertical-align:-2px}
header .tag{color:var(--mute);font-size:13px;font-style:italic}
header .ticker{margin-left:auto;display:flex;flex-wrap:wrap;gap:18px;font-size:12px;color:var(--mute);letter-spacing:.04em}
header .ticker b{color:var(--fg);font-weight:600}
.beta{display:none}
nav{display:flex;flex-wrap:wrap;gap:22px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:12px 0 0}
nav a{color:var(--mute);padding-bottom:3px}nav a:hover{color:var(--fg);text-decoration:none;border-bottom:1px solid var(--accent)}
.grid{display:grid;gap:22px;margin-top:22px}
.intro{display:flex;flex-direction:column;gap:10px;padding:34px 0 10px;max-width:900px}
.hero{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
@media (max-width:980px){.hero{grid-template-columns:minmax(0,1fr)}}
.hero .tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 20px}
.hero .map{min-height:520px}
.gh{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
@media (max-width:980px){.hero,.gh{grid-template-columns:minmax(0,1fr)}}
.headline{font-size:52px;font-weight:700;letter-spacing:-.02em;line-height:1.05;background:linear-gradient(90deg,#f3f6ff 0%,#8fb4ff 55%,#a78bfa 100%);-webkit-background-clip:text;background-clip:text;color:transparent;padding-bottom:2px}
.lead{font-size:19px;color:var(--fg);font-weight:500}
.lead2{font-size:14px;color:var(--mute)}
#map .map{min-height:520px}
#map.full{position:fixed;inset:0;z-index:50;border-radius:0;margin:0;padding:24px 32px;overflow:auto;background:var(--bg)}
#map.full .map{min-height:calc(100vh - 150px)}
#map.full .map svg{height:calc(100vh - 170px);width:100%}
.fsbtn{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);cursor:pointer;white-space:nowrap}
#totop{position:fixed;right:22px;bottom:22px;width:40px;height:40px;border-radius:20px;border:1px solid var(--line2);background:#0f1626ee;color:var(--fg);font-size:16px;cursor:pointer;display:none;align-items:center;justify-content:center;z-index:40;box-shadow:0 4px 18px rgba(0,0,0,.4)}
#totop:hover{border-color:var(--accent);color:var(--accent)}
#totop.show{display:flex}
html{scroll-behavior:smooth}
.glow{filter:url(#glow)}
.g2{grid-template-columns:minmax(0,7fr) minmax(0,5fr)}
.g2b{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}
@media (max-width:980px){.g2,.g2b{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:22px 24px 24px;min-width:0;display:flex;flex-direction:column;gap:16px}
.panel h2::before{content:'';display:inline-block;width:10px;height:10px;border-radius:2px;background:linear-gradient(135deg,var(--blue),var(--violet));margin-right:12px;vertical-align:-1px}
.panel.foldable h2{cursor:pointer;user-select:none}
.panel.foldable h2::before{content:'';width:14px;height:12px;border-radius:0;background:linear-gradient(135deg,var(--blue),var(--violet));clip-path:polygon(0 0,100% 0,50% 100%);margin-right:12px;vertical-align:-1px;transition:transform .15s}
.panel.foldable.fold h2::before{transform:rotate(-90deg)}
.panel.foldable h2:hover::before{background:var(--fg)}
.panel h2 .toggle{display:none}
.panel h2{margin:0;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--fg);font-weight:700;display:flex;flex-wrap:wrap;align-items:baseline;gap:12px}
.panel h2 .sub{font-weight:400;text-transform:none;letter-spacing:0;color:var(--mute);font-size:13px}
.panel h2 .sub.mono{font-size:12px}
.panel h2 .right{margin-left:auto;display:flex;gap:16px}
.panel h2 .toggle:last-child{margin-left:auto}
.panel h2 .info{display:inline-block;width:14px;height:14px;border:1px solid var(--line2);border-radius:7px;color:var(--mute);font-size:9px;line-height:12px;text-align:center;cursor:help;font-weight:400;letter-spacing:0;vertical-align:1px}
.q{display:none;font-size:13px;color:var(--mute);line-height:1.5}
body.howto .q{display:block}
.howto-btn{margin-left:auto;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);cursor:pointer;border:1px solid var(--line2);border-radius:4px;padding:4px 10px;background:transparent;font-family:inherit}
body.howto .howto-btn{background:var(--accent);color:#06101f;border-color:var(--accent)}
.sub1{font-size:14px;color:var(--mute);padding:12px 0 0;max-width:820px;line-height:1.55}
.sub1 b{color:var(--fg);font-weight:500}
.heat .grp{grid-column:1 / -1;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);padding:8px 0 2px}
.about{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;font-size:13px;color:var(--mute);line-height:1.6}
.about b{display:block;color:var(--fg);font-weight:600;margin-bottom:4px}
@media (max-width:980px){.about{grid-template-columns:minmax(0,1fr)}}
.statline{display:flex;flex-wrap:wrap;gap:22px;font-size:13px;color:var(--mute)}
.statline b{color:var(--fg);font-weight:600}
.fact{font-size:15px;color:var(--fg);border-left:3px solid var(--accent);padding:4px 0 4px 14px;line-height:1.5}
.fact:empty{display:none}
.chip{border:0;background:transparent;padding:0 0 3px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);cursor:pointer;font-family:inherit}
.chip:hover{color:var(--fg)}
.chip.on{color:var(--fg);border-bottom:1px solid var(--accent)}
.tag{border:1px solid var(--line2);border-radius:2px;padding:0 6px;font-size:11px;color:var(--mute);letter-spacing:.02em;white-space:nowrap}
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 24px}
.tiles3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 24px}
@media (max-width:700px){.tiles,.tiles3{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 16px}}
.tile{border-left:1px solid var(--line2);padding:2px 0 2px 14px;display:flex;flex-direction:column;gap:3px}
.tiles{gap:0 20px}
.tile .l{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
.tile .v{font-size:36px;font-weight:700;line-height:1.05;letter-spacing:-.01em}
.tile .v small{font-size:14px;font-weight:400;color:var(--mute);margin-left:2px}
.tile .d{font-size:13px;color:var(--mute)}
.tile .d.up{color:var(--up)}.tile .d.down{color:var(--down)}.tile .d.flag{color:var(--warn)}
.tile .n{font-size:12px;color:var(--dim)}
.tile.hot .v{color:var(--warn);font-size:24px;line-height:1.3}
.tile.hot{border-left-color:var(--warn)}
.tiles3 .tile .v{font-size:22px}
.heat{display:grid;grid-template-columns:150px repeat(8,minmax(0,1fr));gap:3px;font-size:11px;color:var(--mute);align-items:center}
.heat .wk{text-align:center;letter-spacing:.04em}
.heat .lay{cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:var(--mute);padding-right:6px}
.heat .lay:hover{color:var(--fg)}
.heat .c{height:24px;border-radius:3px;position:relative;display:flex;align-items:center;justify-content:center;color:#eaf1ff;font-size:11px;font-weight:500;cursor:pointer}
.heat .lgd{grid-column:1 / -1;display:flex;align-items:center;gap:6px;font-size:10px;color:var(--mute);padding-top:8px}
.heat .lgd i{display:inline-block;width:18px;height:8px;border-radius:2px}
.heat .c i{position:absolute;top:1px;right:3px;font-style:normal;font-size:8px;color:var(--warn)}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);padding:6px 8px;border-bottom:1px solid var(--line2);font-weight:600}
td{padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.4}
tr.row:hover td{background:#13203a}
tr.row{cursor:pointer}
tr.row.new td{background:#1a1a12}
td.what{color:var(--mute);font-size:13px}
.num{text-align:right;white-space:nowrap}
.imp{letter-spacing:1px;color:var(--fg);font-size:12px}
.imp .o{color:var(--line2)}
.map{position:relative;min-height:380px;background:#0a1120;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.map svg{display:block;width:100%;height:auto}
.legend{position:absolute;right:10px;bottom:10px;font-size:11px;color:var(--mute);background:#0f1626e6;border-radius:4px;border:1px solid var(--line2);padding:6px 10px;line-height:1.8;letter-spacing:.02em}
.legend .sw{display:inline-block;width:9px;height:9px;border-radius:5px;vertical-align:-1px;margin-right:5px}
.tip{position:fixed;pointer-events:none;background:#0f1626;border-radius:6px;border:1px solid var(--line2);color:var(--fg);padding:8px 10px;font-size:12px;max-width:320px;z-index:10;display:none;line-height:1.45}
.circuit{position:relative;min-height:360px}
.circuit svg{display:block;width:100%;height:auto}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 24px}
@media (max-width:980px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
.card{border:1px solid var(--line);border-radius:6px;padding:12px 14px;display:flex;flex-direction:column;gap:5px;cursor:pointer;background:#0c1322}
.card:hover{border-color:var(--accent)}
.card .nm{display:flex;justify-content:space-between;gap:8px;font-weight:600;align-items:baseline}
.card .et{font-size:12px;color:var(--dim);letter-spacing:.02em}
.card .spark{display:flex;gap:2px;align-items:flex-end;height:18px}
.card .spark i{display:block;width:8px;background:var(--line2)}
.card .spark i.now{background:var(--accent)}
.filters{display:flex;flex-wrap:wrap;gap:8px}
select,input{background:#0a1120;color:var(--fg);border:1px solid var(--line2);border-radius:4px;padding:7px 10px;font-size:13px;font-family:inherit}
input{flex:1;min-width:200px}
.more{text-align:center;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);padding:10px;cursor:pointer}
.more:hover{color:var(--fg)}
.divider{text-align:center;font-size:11px;color:var(--mute);padding-top:14px;margin-top:28px;letter-spacing:.18em}
.panel.fold .body{display:none}
.panel.fold .fact{margin-top:-4px}
.panel h2 .toggle{margin-left:4px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);cursor:pointer;font-weight:500;white-space:nowrap}
.panel h2 .toggle::before{content:'▸ expand'}
.panel:not(.fold) h2 .toggle::before{content:'▾ collapse'}
.panel.fold .q{display:none}
footer{margin-top:40px;border-top:1px solid var(--line2);padding-top:12px;font-size:11px;color:var(--mute);display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}
.detail{font-size:13px;color:var(--mute);padding:4px 8px 12px 44px;line-height:1.5}
.stage0{opacity:.4}.stage1{opacity:.85}.stage2{opacity:1}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1><span class="mark"></span>{{ brand.name }}</h1>
  <span class="tag">{{ brand.tagline_en }}</span>
  <div class="ticker mono" id="ticker"></div>
</header>
<nav><a href="#numbers">Numbers</a><a href="#activity">Activity</a><a href="#deals">Deals</a><a href="#map">Map</a><a href="#circuits">Circuits</a><a href="#feed">Signals</a><a href="#panel">The Panel</a><a href="latest-report.md">Weekly report</a><a href="#about">About</a><button class="howto-btn" id="howto">How to read this board</button></nav>

<div class="intro"><div class="headline">Follow the current.</div>
  <div class="lead">Who powers AI, who pays, and why now.</div>
  <div class="lead2">A weekly radar of the electricity behind AI compute · updated Mondays · every line links to its source</div></div>
<div class="grid hero">
  <section class="panel" id="numbers">
    <h2>This week in numbers <span class="info" title="Machine-counted, week over week. The two kinds of MW are never added together.">i</span></h2>
    
    <div class="tiles" id="tiles1"></div>
    <div class="statline" id="tiles2"></div>
    <div class="fact" id="fact1"></div>
  </section>
  <section class="panel foldable" id="map">
    <h2>Committed capacity <span class="info" title="Where the money lands. Dot = a project or contract in the last 8 weeks; size = MW; hollow = generation (nameplate), filled = data center (IT load); faded = announced, solid = contracted, ring = operational.">i</span><span class="toggle"></span><span class="fsbtn" id="fsbtn">⤢ Full screen</span><span class="right"><span class="chip on" data-kind="all">All</span><span class="chip" data-kind="nameplate">Generation</span><span class="chip" data-kind="it_load">Data centers</span></span></h2>
    <div class="fact" id="fact4"></div>
    <div class="body">
    
    <div class="map" id="mapbox"><div class="legend"><span class="sw" style="background:var(--load)"></span>Data center · IT load (MW)<br><span class="sw" style="border:2px solid var(--gen);background:transparent"></span>Generation · nameplate (MW)<br>faded = announced · solid = contracted · ring = operational<br><span class="sw" style="background:var(--warn);box-shadow:0 0 8px var(--warn)"></span>glow = this week</div></div>
  </div>
  </section>
</div>
<div class="grid gh">
  <section class="panel" id="activity">
    <h2>Activity by layer <span class="sub" id="srcnote"></span> <span class="info" title="Cell shade = this week vs the layer's own 8-week average; number = distinct events; ▲ = an Impact-5 event that week. Click a layer to filter the signal feed.">i</span></h2>
    
    <div class="heat" id="heat"></div>
    <div class="fact" id="fact2"></div>
  </section>
  <section class="panel" id="deals">
    <h2>Biggest deals <span class="info" title="Who pays whom, and how much. Parties in plain verbs; Size and Value in fixed units; figures tagged disclosed / reported / est.">i</span><span class="right" id="dealtabs"></span></h2>
    
    <div style="overflow-x:auto"><table id="dealtable"></table></div>
    <div class="fact" id="fact3"></div>
  </section>
</div>
<div class="grid">
  <section class="panel foldable fold" id="circuits">
    <h2>Circuits <span class="sub">who is connected to whom</span> <span class="info" title="Fixed layout: demand on the left, compute and development in the middle, supply on the right. The 15 largest relations on record; numbers written on the edges; this week's new edges highlighted. Solid = power or supply, dashed = investment.">i</span><span class="toggle"></span><span class="right"><span class="chip on" data-rel="all">All</span><span class="chip" data-rel="buys_power_from">Power</span><span class="chip" data-rel="invests_in">Investment</span><span class="chip" data-rel="supplies_to">Supply</span></span></h2>
    <div class="fact" id="fact5"></div>
    <div class="body">
    
    <div class="circuit" id="circuitbox"></div>
  </div>
  </section>
</div>

<div class="divider">END OF THE BRIEF · BELOW: THE FULL FEED AND THE PANEL</div>

<div class="grid">
  <section class="panel foldable fold" id="feed">
    <h2>Signal feed <span class="sub mono" id="feedcount"></span><span class="toggle"></span></h2>
    <div class="body">
    <div class="filters">
      <select id="fL"><option value="">All layers</option></select>
      <select id="fT"><option value="">All types</option></select>
      <select id="fE"><option value="">All entities</option></select>
      <select id="fI"><option value="1">Impact ≥ 1</option><option value="2">Impact ≥ 2</option><option value="3" selected>Impact ≥ 3</option><option value="4">Impact ≥ 4</option><option value="5">Impact 5</option></select>
      <select id="fW"><option value="week">This week</option><option value="all" selected>Last 90 days</option></select>
      <input id="fQ" placeholder="search title / summary">
    </div>
    <div style="overflow-x:auto"><table id="feedtable"></table></div>
    <div class="more" id="feedmore"></div>
  </div>
  </section>
</div>

<div class="grid">
  <section class="panel foldable fold" id="panel">
    <h2>The Panel <span class="sub">the companies we track</span> <span class="info" title="Sorted by activity this week. Click a card to filter the feed.">i</span><span class="toggle"></span></h2>
    <div class="body">
    
    <div class="cards" id="cards"></div>
    <div class="more" id="cardsmore"></div>
  </div>
  </section>
</div>

<div class="grid">
  <section class="panel" id="about">
    <h2>About this board</h2>
    <div class="about">
      <div><b>What it is</b>AI compute runs on electricity, and electricity is now the binding constraint: gas turbines are sold out for years, interconnection queues run five years, and hyperscalers are signing 20-year nuclear contracts. Current Board tracks that layer week by week — who supplies the power, who pays for it, and why now.</div>
      <div><b>How it is made</b>Every week the pipeline collects public news for 38 tracked entities and ten value-chain layers, and Claude classifies each item: layer, type, importance 1–5, MW, money, location, and who-did-what-to-whom. The analyst reviews the top signals and writes the weekly view. The board is built only from whitelisted fields and checked for leaks before publishing.</div>
      <div><b>Read the numbers carefully</b>Figures carry a source grade — disclosed, reported, or estimated — and two kinds of MW are never added: a power plant's nameplate capacity and a data center's IT load are different things. Importance is a machine score until the analyst overrides it. Click any line to reach its source.</div>
    </div>
  </section>
</div>

<footer><span>{{ brand.footer_en }}</span><span>Free, public sources · classification by Claude, judgment by the analyst · <a href="https://github.com/wt-hsu/current-board">How the board is wired</a></span></footer>
</div>
<div class="tip" id="tip"></div>
<button id="totop" aria-label="Back to top" title="Back to top">↑</button>

<script id="data" type="application/json">{{ data_json }}</script>
<script id="world" type="application/json">{{ world_json }}</script>
<script>
const D = JSON.parse(document.getElementById('data').textContent);
document.querySelectorAll('.panel h2 .info').forEach(i => { const q = document.createElement('div'); q.className = 'q'; q.textContent = i.title; const h = i.closest('h2'); h.parentNode.insertBefore(q, h.nextSibling); });
document.getElementById('howto').onclick = () => document.body.classList.toggle('howto');
document.querySelectorAll('.panel.foldable h2').forEach(h => h.addEventListener('click', ev => { if (ev.target.closest('.right, .fsbtn, .info, select, input')) return; h.closest('.panel').classList.toggle('fold'); }));
const fsbtn = document.getElementById('fsbtn'); fsbtn.onclick = () => { const m = document.getElementById('map'); m.classList.toggle('full'); fsbtn.textContent = m.classList.contains('full') ? '✕ Close' : '⤢ Full screen'; };
document.addEventListener('keydown', e => { if (e.key === 'Escape') { document.getElementById('map').classList.remove('full'); fsbtn.textContent = '⤢ Full screen'; } });
const totop = document.getElementById('totop'); totop.onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});
window.addEventListener('scroll', () => totop.classList.toggle('show', window.scrollY > 600), {passive: true});
const unfold = id => document.getElementById(id)?.classList.remove('fold');
document.querySelectorAll('nav a[href^="#"]').forEach(a => a.addEventListener('click', () => unfold(a.getAttribute('href').slice(1))));
const L = (kind, code) => (D.labels[kind]?.[code]?.en) || (code || 'other');
const LAYERS = Object.keys(D.labels.value_chain);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmtUsd = v => v == null ? '—' : v >= 1e9 ? '$' + (v/1e9).toFixed(1) + 'B' : v >= 1e6 ? '$' + Math.round(v/1e6) + 'M' : '$' + Math.round(v/1e3) + 'K';
const fmtMw = v => v == null ? '—' : v >= 1000 ? (v/1000).toFixed(1) + ' GW' : Math.round(v) + ' MW';
const fmtMwNum = v => v >= 1000 ? (v/1000).toFixed(1) + ' GW' : Math.round(v).toLocaleString() + ' MW';
const imp = n => '<span class="imp" title="Impact ' + n + '/5: machine-scored on the importance scale (5 = changes a layer\'s supply/demand structure)">' + [1,2,3,4,5].map(i => i <= n ? '●' : '<span class="o">○</span>').join('') + '</span>';
