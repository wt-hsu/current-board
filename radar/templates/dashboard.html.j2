    const w = 1 + 4 * (((r.value_usd||0) + (r.capacity_mw||0)*1e6) / maxV);
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
    const sameCol = a.x === b.x; const cx = sameCol ? a.x + 120 : mx, cy = sameCol ? my : my - Math.abs(b.y - a.y) * .15;
    edges.append('path').attr('d', `M${a.x},${a.y} Q${cx},${cy} ${b.x},${b.y}`).attr('fill', 'none').attr('stroke', isNew ? 'var(--warn)' : '#3a4a6a').attr('stroke-width', w).attr('stroke-dasharray', r.relation_type === 'invests_in' ? '6 4' : null).attr('opacity', .95);
    const label = [r.capacity_mw ? fmtMw(r.capacity_mw) : null, r.value_usd ? fmtUsd(r.value_usd) : null, r.term_years ? r.term_years + 'y' : null].filter(Boolean).join(' · ') || L('relation_types', r.relation_type);
    const text = label + (isNew ? ' · NEW' : ''); const lx = sameCol ? a.x + 60 : mx, ly = sameCol ? my : (my + cy) / 2;
    const lg = labels.append('g').attr('transform', `translate(${lx},${ly})`).style('cursor', 'pointer');
    const pw = text.length * 6.2 + 14;
    lg.append('rect').attr('x', -pw/2).attr('y', -9).attr('width', pw).attr('height', 18).attr('rx', 9).attr('fill', '#0f1626').attr('stroke', isNew ? 'var(--warn)' : 'var(--line2)').attr('stroke-width', 1);
    lg.append('text').attr('text-anchor', 'middle').attr('dy', 3.5).attr('font-size', 10).attr('fill', isNew ? 'var(--warn)' : 'var(--fg)').attr('font-family', 'JetBrains Mono, monospace').text(text);
    const t = lg;
    t.on('mousemove', ev => showTip(ev, `<b>${esc(r.subject_name)}</b> ${esc(L('relation_types', r.relation_type))} <b>${esc(r.object_name)}</b><br>${label}<br><span style="color:var(--mute)">${esc(r.value_source || 'estimated')} · confidence ${Math.round((r.confidence||0)*100)}% · first seen ${esc((r.first_seen||'').slice(0,10))}</span>`)).on('mouseleave', hideTip).on('click', () => r.source_url && window.open(r.source_url, '_blank'));
  });
  nodes.forEach(n => { const g = nodesG.append('g').attr('transform', `translate(${n.x},${n.y})`).style('cursor', 'pointer').on('click', () => { if (byCompany[n.key]) { fE.value = n.key; fW.value = 'all'; renderFeed(); unfold('feed'); location.hash = '#feed'; } });
    const wdt = Math.max(100, n.name.length * 7.5 + 24);
    g.append('rect').attr('x', -wdt/2).attr('y', -14).attr('width', wdt).attr('height', 28).attr('rx', 6).attr('fill', n.col === 0 ? 'url(#nodegrad)' : n.col === 1 ? '#1a2439' : '#0e1626').attr('stroke', n.col === 2 ? 'var(--accent)' : n.col === 1 ? 'var(--line2)' : 'none').attr('stroke-width', 1.5);
    g.append('text').attr('text-anchor', 'middle').attr('dy', 4).attr('font-size', 12).attr('font-weight', n.col === 0 ? 600 : 500).attr('fill', 'var(--fg)').attr('font-family', 'Inter, sans-serif').text(n.name); });
  const newest = D.relations.filter(r => r.week_first === D.week).sort((a,b)=>((b.value_usd||0)+(b.capacity_mw||0)*1e6)-((a.value_usd||0)+(a.capacity_mw||0)*1e6))[0];
  document.getElementById('fact5').textContent = newest ? `${newest.subject_name}–${newest.object_name} is new on the board this week${newest.mentions > 1 ? ', reported ' + newest.mentions + ' times' : ''}.` : `No new relations this week; ${rels.length} largest relations on record shown.`;
}
document.querySelectorAll('#circuits .chip').forEach(c => c.onclick = () => { document.querySelectorAll('#circuits .chip').forEach(x => x.classList.remove('on')); c.classList.add('on'); renderCircuits(c.dataset.rel); });
renderCircuits('all');

// ---- feed ----
const fL = document.getElementById('fL'), fT = document.getElementById('fT'), fE = document.getElementById('fE'), fI = document.getElementById('fI'), fW = document.getElementById('fW'), fQ = document.getElementById('fQ');
LAYERS.forEach(l => fL.insertAdjacentHTML('beforeend', `<option value="${l}">${esc(L('value_chain',l))}</option>`));
Object.keys(D.labels.signal_types).forEach(t => fT.insertAdjacentHTML('beforeend', `<option value="${t}">${esc(L('signal_types',t))}</option>`));
D.companies.slice().sort((a,b)=>a.name.localeCompare(b.name)).forEach(c => fE.insertAdjacentHTML('beforeend', `<option value="${c.slug}">${esc(c.name)}</option>`));
let feedLimit = 6;
function renderFeed(){
  const q = fQ.value.trim().toLowerCase();
  const rows = D.signals.filter(s => (fW.value !== 'week' || weekIds.has(s.id)) && (!fL.value || s.value_chain === fL.value) && (!fT.value || s.signal_type === fT.value) && (!fE.value || (s.company_slugs||[]).includes(fE.value)) && (s.importance||1) >= +fI.value && (!q || (s.title + ' ' + (s.summary||'')).toLowerCase().includes(q)))
    .sort((a,b) => (b.date||'').localeCompare(a.date||'') || b.importance - a.importance);
  document.getElementById('feedcount').textContent = `· showing ${Math.min(feedLimit, rows.length)} of ${rows.length}`;
  let html = '<tr><th>Date</th><th>Impact</th><th>Signal</th><th>Layer</th><th>Type</th><th class="num">Figures</th><th>Source</th></tr>';
  if (!rows.length) html += '<tr><td colspan="7" style="color:var(--dim)">No signals match.</td></tr>';
  rows.slice(0, feedLimit).forEach(s => {
    const figs = [s.capacity_mw ? fmtMw(s.capacity_mw) + (s.capacity_kind === 'it_load' ? ' load' : '') : null, s.deal_value_usd ? fmtUsd(s.deal_value_usd) : null].filter(Boolean).join(' · ') || '—';
    html += `<tr class="row" data-id="${s.id}"><td class="mono">${esc((s.date||'').slice(5))}</td><td>${imp(s.importance||1)}</td><td><b style="font-weight:600">${esc(s.title)}</b>${s.companies.length ? `<div style="font-size:11px;color:var(--mute)">${esc(s.companies.join(', '))}</div>` : ''}</td><td><span class="tag">${esc(L('value_chain', s.value_chain))}</span></td><td><span class="tag">${esc(L('signal_types', s.signal_type))}</span></td><td class="num mono">${figs}</td><td><a href="${esc(s.link)}" target="_blank" rel="noopener">${esc(s.source || 'source')} ↗</a></td></tr>`;
    html += `<tr class="dt" data-for="${s.id}" style="display:none"><td colspan="7" class="detail">${esc(s.summary || '')}${s.location_name ? ` · <span class="mono">${esc(s.location_name)}${s.grid_region ? ' · ' + esc(s.grid_region) : ''}</span>` : ''}${s.project_stage ? ` · ${esc(s.project_stage)}` : ''}</td></tr>`;
  });
  const t = document.getElementById('feedtable'); t.innerHTML = html;
  t.querySelectorAll('tr.row').forEach(r => r.onclick = ev => { if (ev.target.tagName === 'A') return; const d = t.querySelector(`tr.dt[data-for="${r.dataset.id}"]`); d.style.display = d.style.display === 'none' ? '' : 'none'; });
  const more = document.getElementById('feedmore');
  more.textContent = rows.length > feedLimit ? `▾ Show all ${rows.length} signals` : rows.length > 6 ? '▴ Show fewer' : '';
  more.onclick = () => { feedLimit = rows.length > feedLimit ? rows.length : 6; renderFeed(); };
}
[fL, fT, fE, fI, fW].forEach(el => el.onchange = () => { feedLimit = 6; renderFeed(); }); fQ.oninput = () => { feedLimit = 6; renderFeed(); };
renderFeed();

// ---- the panel ----
{ const weekBy = {}; sigWeek(D.week).forEach(s => (s.company_slugs||[]).forEach(k => weekBy[k] = (weekBy[k]||0) + 1));
  const hist = {}; D.companies.forEach(c => hist[c.slug] = WEEKS.map(w => sigWeek(w).filter(s => (s.company_slugs||[]).includes(c.slug)).length));
  const cards = D.companies.filter(c => c.status === 'active').sort((a,b) => (weekBy[b.slug]||0) - (weekBy[a.slug]||0) || (b.signal_count||0) - (a.signal_count||0));
  let cardLimit = 8;
  const renderCards = () => { document.getElementById('cards').innerHTML = cards.slice(0, cardLimit).map(c => { const h = hist[c.slug]; const mx = Math.max(1, ...h);
    return `<div class="card" data-slug="${c.slug}"><div class="nm"><span>${esc(c.name)}</span><span class="tag">${esc(L('entity_types', c.entity_type))}</span></div><div class="et mono">${esc(L('value_chain', c.value_chain))}${c.region ? ' · ' + esc(c.region) : ''}</div><div class="spark">${h.map((v,i) => `<i class="${i===7?'now':''}" style="height:${Math.max(2, 18*v/mx)}px" title="${WEEKS[i]}: ${v}"></i>`).join('')}</div><div class="et">${weekBy[c.slug]||0} this week · ${c.signal_count||0} in 90 days · ${c.relation_count||0} circuits</div></div>`; }).join('');
    document.querySelectorAll('.card').forEach(el => el.onclick = () => { fE.value = el.dataset.slug; fW.value = 'all'; feedLimit = 6; renderFeed(); unfold('feed'); location.hash = '#feed'; });
    const m = document.getElementById('cardsmore'); m.textContent = cards.length > cardLimit ? `▾ Show all ${cards.length} on the panel` : cards.length > 8 ? '▴ Show fewer' : ''; m.onclick = () => { cardLimit = cards.length > cardLimit ? cards.length : 8; renderCards(); }; };
  renderCards(); }
</script>
</body>
</html>
