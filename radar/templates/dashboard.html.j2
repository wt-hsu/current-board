<body>
<div class="wrap">
<header>
  <h1><svg class="bolt" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="boltg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22d3ee"/><stop offset=".55" stop-color="#3b82f6"/><stop offset="1" stop-color="#8b5cf6"/></linearGradient></defs><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" fill="url(#boltg)"/></svg>{{ brand.name }}</h1>
  <span class="tag">{{ brand.tagline_en }}</span>
  <div class="ticker mono" id="ticker"></div>
</header>
<nav><a href="#numbers">Numbers</a><a href="#activity">Activity</a><a href="#deals">Deals</a><a href="#map">Map</a><a href="#circuits">Circuits</a><a href="#feed">Signals</a><a href="#panel">The Panel</a></nav>

<div class="intro"><div class="headline">Tracking the Current in <span class="rot"><span class="roll" id="roll"></span></span></div>
  <div class="lead">Who powers AI, who pays, and why now.</div>
  <div class="lead2">A weekly radar of the electricity behind AI compute · updated Mondays · every line links to its source</div>
  <div class="introrow"><button class="wtf" id="wtf">What am I looking at? ▾</button><button class="wtf tourbtn" id="tour">▶ How to read this board</button></div>
  <div class="explain" id="explain">
    <div><b>What this is</b>AI data centers need enormous amounts of electricity, and getting it has become the hard part: turbines are back-ordered, grid connections take years, and tech companies are signing 20-year deals with nuclear plants. This board follows that story every week — who supplies the power, who pays for it, and what changed.</div>
    <div><b>Where the data comes from</b>Public news and company announcements, collected automatically each week for about forty companies across the power and data-center supply chain. An AI model reads each article and records the layer, the type of event, the MW and dollar figures, the location and who dealt with whom. A human analyst reviews the most important items. Every line links to its source.</div>
    <div><b>How to read the numbers</b>A power plant's capacity (nameplate MW) and a data center's demand (IT load MW) are different things and are kept apart. Dollar figures are marked as stated by the parties, reported by media, or estimated. Impact 1–5 is the model's view of how much an event changes the market. Hover any dotted term for a definition.</div>
  </div></div>
<div class="grid hero">
  <section class="panel" id="numbers">
    <h2>This week in numbers <span class="sub">vs last week</span> <span class="info" title="The headline numbers for the week. Generation contracted = power-plant capacity signed under long-term contracts (nameplate MW). DC load announced = new data-center demand (IT load MW). These are different units and are never added together. Disclosed value counts only figures the parties themselves stated.">i</span></h2>
    
    <div class="tiles" id="tiles1"></div>
    <div class="statline" id="tiles2"></div>
    <div class="fact" id="fact1"></div>
  </section>
  <section class="panel foldable" id="map">
    <h2>Committed capacity <span class="sub">last 8 weeks</span> <span class="info" title="Where new capacity is landing. Each dot is a project or contract from the last 8 weeks, sized by MW. Filled = data center (IT load), hollow = power generation (nameplate). Dashed outline = the article only named a region or country, so the dot sits at its centre. Hover for details, click to open the source. Scroll or use + − to zoom.">i</span><span class="toggle"></span><span class="fsbtn" id="fsbtn">⤢ Full screen</span><span class="right"><span class="chip on" data-kind="all">All</span><span class="chip" data-kind="nameplate">Generation</span><span class="chip" data-kind="it_load">Data centers</span></span></h2>
    <div class="regions" id="regions"></div>
    <div class="fact" id="fact4"></div>
    <div class="body">
    
    <div class="map" id="mapbox"><div class="mapcount mono" id="mapcount"></div><div class="legend"><span><i class="sw" style="background:var(--load)"></i>Data center · IT load</span><span><i class="sw" style="border:2px solid var(--gen);background:transparent"></i>Generation · nameplate</span><span>faded = announced · solid = contracted · ring = operational</span><span><i class="sw" style="border:1px dashed var(--violet);background:transparent"></i>dashed = region/country only</span><span><i class="sw" style="background:var(--cyan);box-shadow:0 0 8px var(--cyan)"></i>this week · <i class="sw" style="background:var(--violet2);box-shadow:0 0 8px var(--violet2)"></i>last week</span></div><div class="zoomctl"><button id="zin" aria-label="Zoom in">+</button><button id="zout" aria-label="Zoom out">−</button><button id="zreset" aria-label="Reset zoom">⟲</button></div></div>
  </div>
  </section>
</div>
<div class="grid gh">
  <section class="panel" id="activity">
    <h2>Activity by layer <span class="sub">last 8 weeks</span><span class="sub" id="srcnote"></span> <span class="info" title="How busy each part of the value chain has been, week by week. The number is how many distinct events happened; the shade shows whether that is above or below the layer's own 8-week average. A small gold dot marks a week with a top-impact event. Click a layer to see its signals.">i</span></h2>
    
    <div class="heat" id="heat"></div>
    <div class="fact" id="fact2"></div>
  </section>
  <section class="panel" id="deals">
    <h2>Biggest deals <span class="sub">this week first, then 90 days</span> <span class="info" title="The largest transactions on record: power contracts, acquisitions, funding rounds and build-outs. Size is in MW, Value in US dollars. Values are marked by how they are known: stated by the parties (bright), reported by media (grey), or estimated from the article (dim). Tabs filter by deal type; sort by size, value or date.">i</span><span class="right" id="dealtabs"></span></h2>
    
    <div style="overflow-x:auto"><table id="dealtable"></table></div>
    <div class="fact" id="fact3"></div>
  </section>
</div>
<div class="grid">
  <section class="panel foldable fold" id="circuits">
    <h2>Circuits <span class="sub">who is connected to whom · last 90 days</span> <span class="info" title="Who is connected to whom. Buyers of power and compute sit on the left, data-center and compute developers in the middle, power and equipment suppliers on the right. Each line is a contract, supply deal or investment, labelled with its size; solid lines move electricity or equipment, dashed lines move money. Lines that first appeared this week are highlighted.">i</span><span class="toggle"></span><span class="right"><span class="chip on" data-rel="all">All</span><span class="chip" data-rel="buys_power_from">Power</span><span class="chip" data-rel="invests_in">Investment</span><span class="chip" data-rel="supplies_to">Supply</span></span></h2>
    <div class="fact" id="fact5"></div>
    <div class="body">
    
    <div class="circuit" id="circuitbox"></div>
    <div class="clist" id="clist"></div>
    <div class="clegend"><span><i class="ln"></i>buys power from / supplies to</span><span><i class="ln dash"></i>invests in</span><span><i class="ln new"></i>new this week</span><span><i class="nd grad"></i>hyperscalers &amp; chips</span><span><i class="nd mid"></i>AI labs · neoclouds · developers</span><span><i class="nd sup"></i>power &amp; equipment</span><span>line weight = deal size · number on the line = MW · $ · years</span></div>
  </div>
  </section>
</div>

<div class="divider">END OF THE BRIEF · BELOW: THE FULL FEED AND THE PANEL</div>

<div class="grid">
  <section class="panel foldable fold" id="feed">
    <h2>Signal feed <span class="sub">last 90 days</span><span class="sub mono" id="feedcount"></span> <span class="info" title="Every classified article from the last 90 days. Impact 1–5 is the model's estimate of how much an event changes a layer of the market: 5 = changes supply/demand structure (GW-scale deal, nuclear restart, first-of-kind policy); 4 = a major player's concrete commitment with figures; 3 = a named deal with an amount; 2 = commentary or re-reporting; 1 = marginal. The analyst's own scores are not shown here. Click a row to expand its summary.">i</span><span class="toggle"></span></h2>
    <div class="body">
    <div class="filters">
      <select id="fL"><option value="">All layers</option></select>
      <select id="fT"><option value="">All types</option></select>
      <select id="fE"><option value="">All entities</option></select>
      <select id="fI"><option value="1">Impact ≥ 1</option><option value="2">Impact ≥ 2</option><option value="3" selected>Impact ≥ 3</option><option value="4">Impact ≥ 4</option><option value="5">Impact 5</option></select>
      <select id="fW"><option value="week">This week</option><option value="all" selected>Last 90 days</option></select>
      <input id="fQ" placeholder="search title / summary">
    </div>
    <div style="overflow-x:auto"><table id="feedtable"></table></div>
    <div class="more" id="feedmore"></div>
  </div>
  </section>
</div>

<div class="grid">
  <section class="panel foldable fold" id="panel">
    <h2>The Panel <span class="sub">the companies we track · last 8 weeks</span> <span class="info" title="The companies this board follows, sorted by how active they were this week. The small bars show their signal count over the last eight weeks. Click a card to see that company's signals.">i</span><span class="toggle"></span></h2>
    <div class="body">
    
    <div class="cards" id="cards"></div>
    <div class="more" id="cardsmore"></div>
  </div>
  </section>
</div>


<footer><span>{{ brand.footer_en }}</span><span>Free, public sources · classification by Claude, judgment by the analyst · <a href="https://github.com/wt-hsu/current-board">How the board is wired</a></span></footer>
</div>
<div class="tip" id="tip"></div>
<aside id="drawer" aria-hidden="true"><div class="dh"><span id="dtitle">Signals</span><button id="dclose" aria-label="Close">✕</button></div><div class="dcount mono" id="dcount"></div><div class="dbody"><table id="drawertable"></table></div><div class="dfoot"><a href="#feed" id="dall">Open the full feed with these filters →</a></div></aside>
<div id="dmask"></div>
<div class="tour-dim"></div><div class="tour-card" id="tourcard" role="dialog" aria-live="polite"><div class="k"></div><h4></h4><p></p><div class="row"><button class="back">← Back</button><button class="pri next">Next →</button><button class="skip">Skip tour</button></div></div>
<button id="totop" aria-label="Back to top" title="Back to top">↑</button>

<script id="data" type="application/json">{{ data_json }}</script>
<script id="world" type="application/json">{{ world_json }}</script>
<script>
const D = JSON.parse(document.getElementById('data').textContent);
const GLOSS = {
  'MW': 'Megawatt, a unit of power. 1,000 MW = 1 GW, roughly one large nuclear reactor or 3–4 hyperscale data-center campuses.',
  'GW': 'Gigawatt = 1,000 MW. One large nuclear reactor is about 1 GW.',
  'nameplate': 'Nameplate capacity: the maximum output a power plant is built to deliver, in MW. A supply-side number.',
  'IT load': 'IT load: the electricity a data center\'s servers actually draw, in MW. A demand-side number. Never add it to nameplate capacity.',
  'PPA': 'Power purchase agreement: a long-term contract (often 10–20 years) in which a buyer commits to purchase a plant\'s electricity at an agreed price.',
  'offtake': 'Offtake: any agreement to buy a plant\'s output. PPAs are the most common form.',
  'capex': 'Capital expenditure: money a company commits to build plants, campuses or equipment.',
  'SMR': 'Small modular reactor: a new class of smaller nuclear reactor, mostly not yet operating commercially.',
  'grid region': 'The electricity market or operator area a site sits in, such as PJM (Mid-Atlantic US) or ERCOT (Texas). Prices and connection queues differ by region.',
  'interconnection': 'Connecting a plant or data center to the grid. In the US the queue to do so now runs several years.',
  'front-of-meter': 'Supplied through the grid, as opposed to behind-the-meter (connected directly to the plant).',
  'Impact': 'Impact 1–5 is the model\'s estimate of how much an event changes a layer of the market: 5 = changes supply/demand structure (GW-scale deal, nuclear restart, first-of-kind policy); 4 = a major player\'s concrete commitment; 3 = a named deal with figures; 2 = commentary or re-reporting; 1 = marginal.',
  'disclosed': 'Disclosed: the figure was stated by the parties themselves (filing, press release, on-record executive).',
  'reported': 'Reported: a media outlet gave the figure, usually citing sources.',
  'estimated': 'Estimated: derived from the article by the model, not stated by anyone. Treat as rough.',
};
const T = (word, text) => `<abbr class="t" data-k="${word}">${text || word}</abbr>`;
document.addEventListener('mousemove', ev => { const a = ev.target.closest && ev.target.closest('abbr.t'); if (a && GLOSS[a.dataset.k]) showTip(ev, `<div class="tt-h">${esc(a.dataset.k)}</div><div class="tt-r">${esc(GLOSS[a.dataset.k])}</div>`); });
document.addEventListener('mouseout', ev => { if (ev.target.closest && ev.target.closest('abbr.t')) hideTip(); });
const tip = document.getElementById('tip');
const showTip = (ev, html) => { tip.innerHTML = html; tip.style.display = 'block'; tip.style.left = Math.min(ev.clientX + 14, window.innerWidth - 340) + 'px'; tip.style.top = (ev.clientY + 14) + 'px'; };
const hideTip = () => tip.style.display = 'none';
document.querySelectorAll('.panel h2 .info').forEach(i => { const q = document.createElement('div'); q.className = 'q'; q.textContent = i.title; const h = i.closest('h2'); h.parentNode.insertBefore(q, h.nextSibling); i.dataset.tip = i.title; i.removeAttribute('title'); i.addEventListener('mousemove', ev => showTip(ev, '<div class="tt-r">' + esc(i.dataset.tip) + '</div>')); i.addEventListener('mouseleave', hideTip); });

const TOUR = [
  ['numbers', 'This week in numbers', 'Four numbers, one week. Generation (nameplate MW) and data-center demand (IT load MW) are different units and are never added together. Hover any dotted term for a definition.'],
  ['map', 'Committed capacity', 'Each dot is a project from the last 8 weeks, sized by MW. Filled = data center, hollow = generation. A dashed outline means the article only named a region. Scroll to zoom, click a dot to open the source.'],
  ['activity', 'Activity by layer', 'Eleven layers of the supply chain across eight weeks. The number is distinct events; the shade is how that compares with the layer\'s own average, so a quiet layer can light up. Click a cell to see its signals.'],
  ['deals', 'Biggest deals', 'This week first, then the 90-day record. The verb says who did what to whom; the colour of a value says whether it was stated by the parties, reported, or estimated.'],
  ['circuits', 'Circuits', 'Who buys power from whom, who invests in whom. Solid lines move electricity or equipment, dashed lines move money, and the number sits on the line.'],
  ['feed', 'Signal feed & The Panel', 'Every classified article from the last 90 days, with filters, and the companies the board follows. Clicking anywhere above opens a filtered slice of this in a side drawer.'],
];
let ti = -1; const tcard = document.getElementById('tourcard');
function tourStep(i){ document.querySelectorAll('.panel.tour-on').forEach(p => p.classList.remove('tour-on'));
  if (i < 0 || i >= TOUR.length) { document.body.classList.remove('touring', 'howto'); ti = -1; return; }
  ti = i; const [id, h, t] = TOUR[i]; const el = document.getElementById(id); el.classList.remove('fold'); el.classList.add('tour-on'); document.body.classList.add('touring', 'howto');
  tcard.querySelector('.k').textContent = `Step ${i + 1} of ${TOUR.length}`; tcard.querySelector('h4').textContent = h; tcard.querySelector('p').textContent = t;
  tcard.querySelector('.next').textContent = i === TOUR.length - 1 ? 'Done ✓' : 'Next →'; tcard.querySelector('.back').disabled = i === 0;
  tcard.style.animation = 'none'; void tcard.offsetHeight; tcard.style.animation = '';
  el.scrollIntoView({ behavior: 'smooth', block: i === TOUR.length - 1 ? 'start' : 'center' }); }
document.getElementById('tour').onclick = () => tourStep(0);
tcard.querySelector('.next').onclick = () => tourStep(ti + 1); tcard.querySelector('.back').onclick = () => tourStep(Math.max(0, ti - 1)); tcard.querySelector('.skip').onclick = () => tourStep(-1);
document.querySelector('.tour-dim').onclick = () => tourStep(-1);
document.addEventListener('keydown', e => { if (e.key === 'Escape' && ti >= 0) tourStep(-1); });
document.getElementById('wtf').onclick = () => { const e = document.getElementById('explain'); e.classList.toggle('open'); document.getElementById('wtf').textContent = e.classList.contains('open') ? 'What am I looking at? ▴' : 'What am I looking at? ▾'; };
const drawer = document.getElementById('drawer'), dmask = document.getElementById('dmask');
function openDrawer(title){ document.getElementById('dtitle').textContent = title; renderFeed(document.getElementById('drawertable')); drawer.classList.add('open'); dmask.classList.add('open'); drawer.setAttribute('aria-hidden', 'false'); }
function closeDrawer(){ weekFilter = null; drawer.classList.remove('open'); dmask.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); }
document.getElementById('dclose').onclick = closeDrawer; dmask.onclick = closeDrawer;
document.getElementById('dall').onclick = () => { closeDrawer(); unfold('feed'); renderFeed(); };
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
{ const words = ['electricity', 'capital flow', 'power contracts', 'grid capacity', 'policy', 'what is happening now']; const roll = document.getElementById('roll');
  roll.innerHTML = words.map(w => `<span>${w}</span>`).join(''); const sp = [...roll.children]; let wi = 0; sp[0].classList.add('on');
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { const prev = wi; sp[prev].classList.replace('on', 'off'); wi = (wi + 1) % words.length; sp[wi].classList.remove('off'); sp[wi].classList.add('on'); setTimeout(() => sp[prev].classList.remove('off'), 520); }, 2400); }
document.querySelectorAll('.panel h2').forEach(h => { const lead = document.createElement('span'); lead.className = 'leader'; const anchor = h.querySelector('.fsbtn, .right, .toggle'); if (anchor) h.insertBefore(lead, anchor); else h.appendChild(lead); });
document.querySelectorAll('.panel.foldable h2').forEach(h => h.addEventListener('click', ev => { if (ev.target.closest('.right, .fsbtn, .info, select, input')) return; h.closest('.panel').classList.toggle('fold'); }));
const fsbtn = document.getElementById('fsbtn'); fsbtn.onclick = () => { const m = document.getElementById('map'); m.classList.toggle('full'); fsbtn.textContent = m.classList.contains('full') ? '✕ Close' : '⤢ Full screen'; };
document.addEventListener('keydown', e => { if (e.key === 'Escape') { document.getElementById('map').classList.remove('full'); fsbtn.textContent = '⤢ Full screen'; } });
const totop = document.getElementById('totop'); totop.onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});
window.addEventListener('scroll', () => totop.classList.toggle('show', window.scrollY > 600), {passive: true});
const unfold = id => document.getElementById(id)?.classList.remove('fold');
document.querySelectorAll('nav a[href^="#"]').forEach(a => a.addEventListener('click', () => unfold(a.getAttribute('href').slice(1))));
const L = (kind, code) => (D.labels[kind]?.[code]?.en) || (code || 'other');
const LAYERS = Object.keys(D.labels.value_chain);
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmtUsd = v => v == null ? '—' : v >= 1e9 ? '$' + (v/1e9).toFixed(1) + 'B' : v >= 1e6 ? '$' + Math.round(v/1e6) + 'M' : '$' + Math.round(v/1e3) + 'K';
const fmtMw = v => v == null ? '—' : v >= 1000 ? (v/1000).toFixed(1) + ' GW' : Math.round(v) + ' MW';
const fmtMwNum = v => v >= 1000 ? (v/1000).toFixed(1) + ' GW' : Math.round(v).toLocaleString() + ' MW';
const imp = n => '<abbr class="t imp" data-k="Impact">' + [1,2,3,4,5].map(i => i <= n ? '●' : '<span class="o">○</span>').join('') + '</abbr>';
const byCompany = Object.fromEntries(D.companies.map(c => [c.slug, c]));
const weekIds = new Set(D.week_signal_ids);
const weekRelIds = new Set(D.week_relation_ids);

// ---- ISO weeks ----
function isoWeek(dateStr){ const d = new Date(dateStr + 'T00:00:00Z'); const day = (d.getUTCDay() + 6) % 7; d.setUTCDate(d.getUTCDate() - day + 3);
