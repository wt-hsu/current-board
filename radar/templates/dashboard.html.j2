    if (p.week === D.week || p.week === PREV) gglow.append('circle').attr('cx', x).attr('cy', y).attr('r', r(p.capacity_mw) + 6).attr('fill', p.week === D.week ? 'var(--cyan)' : 'var(--violet2)').attr('opacity', p.week === D.week ? .5 : .38).attr('class', 'glow');
    const approx = p.location_precision === 'region' || p.location_precision === 'country';
    const c = gpts.append('circle').attr('cx', x).attr('cy', y).attr('r', r(p.capacity_mw)).attr('class', stageCls(p.project_stage) + (approx ? ' approx' : '')).attr('stroke-dasharray', approx ? '3 3' : null)
      .attr('fill', isLoad ? 'var(--load)' : '#0a1120').attr('fill-opacity', isLoad ? .85 : .9).attr('stroke', approx ? 'var(--violet)' : isLoad ? '#a5f3fc' : 'var(--gen)').attr('stroke-width', isLoad ? 1 : 2).style('cursor', 'pointer');
    if (p.project_stage === 'operational') gglow.append('circle').attr('cx', x).attr('cy', y).attr('r', r(p.capacity_mw) + 3).attr('fill', 'none').attr('stroke', 'var(--fg)').attr('stroke-opacity', .7).attr('stroke-width', 1);
    c.on('mousemove', ev => showTip(ev, `<div class="tt-h">${esc(p.title)}</div>${p.companies.length ? `<div class="tt-r">${esc(p.companies.join(' · '))}</div>` : ''}<div class="tt-r"><b>${fmtMwNum(p.capacity_mw)}</b> ${esc(p.capacity_kind === 'it_load' ? 'IT load' : 'nameplate')} · ${esc((p.project_stage || 'stage n/a').replace('_',' '))}</div><div class="tt-r">${esc(p.location_name || 'location n/a')}${p.grid_region ? ' · ' + esc(p.grid_region) : ''}${(p.location_precision === 'region' || p.location_precision === 'country') ? ' · <span style="color:var(--warn)">approximate (' + esc(p.location_precision) + '-level)</span>' : ''}</div><div class="tt-m">${esc(p.date)} · ${esc(p.source)} · Impact ${p.importance} · click to open source ↗</div>`)).on('mouseleave', hideTip).on('click', () => window.open(p.link, '_blank'));
  });
  const zoom = d3.zoom().scaleExtent([1, 8]).translateExtent([[0,0],[W,H]]).on('zoom', ev => { zoomG.attr('transform', ev.transform); gpts.selectAll('circle').attr('stroke-width', function(){ return (this.classList.contains('glow') ? 0 : (d3.select(this).attr('fill') === 'transparent' ? 2 : 1.2)) / ev.transform.k; }); });
  svg.call(zoom);
  document.getElementById('zin').onclick = () => svg.transition().call(zoom.scaleBy, 1.6);
  document.getElementById('zout').onclick = () => svg.transition().call(zoom.scaleBy, 1/1.6);
  document.getElementById('zreset').onclick = () => svg.transition().call(zoom.transform, d3.zoomIdentity);
  const byRegion = {}; pts.filter(p => p.week === D.week || p.week === PREV).forEach(p => { const k = p.grid_region || p.location_country || '?'; byRegion[k] = (byRegion[k]||0) + p.capacity_mw; });
  const tot = Object.values(byRegion).reduce((a,b)=>a+b,0); const top2 = Object.entries(byRegion).sort((a,b)=>b[1]-a[1]).slice(0,2);
  { const agg = {}; pts.forEach(p => { const k = p.grid_region || p.location_country || 'n/a'; agg[k] = agg[k] || {g:0,l:0}; if (p.capacity_kind === 'it_load') agg[k].l += p.capacity_mw; else agg[k].g += p.capacity_mw; });
    const top = Object.entries(agg).sort((a,b) => (b[1].g + b[1].l) - (a[1].g + a[1].l)).slice(0, 6);
    document.getElementById('regions').innerHTML = top.length ? `<span>By ${T('grid region')}, 8 weeks:</span>` + top.map(([k,v]) => `<span class="r"><b>${esc(k)}</b><span class="mono">${v.g ? fmtMwNum(v.g) + ' gen' : ''}${v.g && v.l ? ' · ' : ''}${v.l ? fmtMwNum(v.l) + ' load' : ''}</span></span>`).join('') : ''; }
  const nAll = PV.filter(e => WEEKS8.includes(e.week)).length, nApprox = pts.filter(p => p.location_precision === 'region' || p.location_precision === 'country').length;
  document.getElementById('mapcount').textContent = `${pts.length} placed (${nApprox} approximate) · ${nAll - pts.length} without a location`;
  document.getElementById('fact4').textContent = !pts.length ? 'No located projects in the last 8 weeks yet — locations arrive with extraction.' :
    tot ? (pct => `${pct >= 50 ? 'Most' : pct + '%'} of the capacity announced in the last two weeks${pct >= 50 ? ' (' + pct + '%)' : ''} sits in ${top2.map(x=>x[0]).join(' and ')}.`)(Math.round(top2.reduce((a,x)=>a+x[1],0)/tot*100)) : `${pts.length} located projects in the last 8 weeks.`;
}
document.querySelectorAll('#map .chip').forEach(c => c.onclick = () => { document.querySelectorAll('#map .chip').forEach(x => x.classList.remove('on')); c.classList.add('on'); renderMap(c.dataset.kind); });
renderMap('all');

// ---- circuits: fixed three-column layout ----
function column(slug, name){ const c = byCompany[slug]; if (!c) return 1; if (c.entity_type === 'ai_lab' || c.entity_type === 'neocloud') return 1; if (c.value_chain === 'compute_demand') return 0; if (['generation_nuclear','generation_other','storage','offtake_markets','transmission_grid','dc_physical'].includes(c.value_chain)) return 2; return 1; }
function renderCircuits(rel){
  const box = document.getElementById('circuitbox'); box.innerHTML = '';
  let rels = D.relations.filter(r => rel === 'all' || r.relation_type === rel).filter(r => r.relation_type !== 'regulates');
  rels.sort((a,b) => ((b.value_usd||0) + (b.capacity_mw||0)*1e6) - ((a.value_usd||0) + (a.capacity_mw||0)*1e6)); rels = rels.slice(0, 12);
  if (!rels.length) { box.innerHTML = '<div style="padding:20px;color:var(--dim)">No relations on record yet.</div>'; document.getElementById('fact5').textContent = ''; return; }
  const nodes = new Map();
  rels.forEach(r => { [[r.subject_slug, r.subject_name], [r.object_slug, r.object_name]].forEach(([s,n]) => { const key = s || n; if (!nodes.has(key)) nodes.set(key, {key, name: n, col: column(s, n), deg: 0}); nodes.get(key).deg++; }); });
  const cols = [[],[],[]]; nodes.forEach(n => cols[n.col].push(n)); cols.forEach(c => c.sort((a,b) => b.deg - a.deg));
  const rows = Math.max(...cols.map(c => c.length)); const W = 1000, rowH = 64, H = Math.max(420, 90 + rowH * rows);
  const X = [150, 500, 850];
  cols.forEach((c, ci) => c.forEach((n, i) => { n.x = X[ci]; n.y = 70 + (H - 100) * (c.length === 1 ? .5 : i / (c.length - 1)); }));
  const svg = d3.select(box).append('svg').attr('viewBox', `0 0 ${W} ${H}`);
  const gd = svg.append('defs').append('linearGradient').attr('id', 'nodegrad').attr('x1', 0).attr('x2', 1).attr('y1', 0).attr('y2', 1); gd.append('stop').attr('offset', '0%').attr('stop-color', '#5b3fd1'); gd.append('stop').attr('offset', '100%').attr('stop-color', '#2a5cd4');
  [['HYPERSCALERS & CHIPS', X[0]], ['AI LABS · NEOCLOUDS · DEVELOPERS', X[1]], ['POWER & EQUIPMENT', X[2]]].forEach(([t,x]) => svg.append('text').attr('x', x).attr('y', 22).attr('text-anchor', 'middle').attr('fill', 'var(--mute)').attr('font-size', 11).attr('font-weight', 700).attr('letter-spacing', 2.5).attr('font-family', 'Inter, sans-serif').text(t));
  const maxV = d3.max(rels, r => (r.value_usd||0) + (r.capacity_mw||0)*1e6) || 1;
  const edges = svg.append('g'), nodesG = svg.append('g'), labels = svg.append('g'); const placed = [];
  rels.forEach((r, ei) => { const a = nodes.get(r.subject_slug || r.subject_name), b = nodes.get(r.object_slug || r.object_name); const isNew = r.week_first === D.week;
    const w = 1.2 + 2.3 * Math.sqrt(((r.value_usd||0) + (r.capacity_mw||0)*1e6) / maxV);
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
    const sameCol = a.x === b.x; const cx = sameCol ? a.x + 120 : mx, cy = sameCol ? my : my - Math.abs(b.y - a.y) * .15;
    edges.append('path').attr('d', `M${a.x},${a.y} Q${cx},${cy} ${b.x},${b.y}`).attr('fill', 'none').attr('stroke', isNew ? 'var(--warn)' : '#3a4a6a').attr('stroke-width', w).attr('stroke-dasharray', r.relation_type === 'invests_in' ? '6 4' : null).attr('opacity', .95);
    const label = [r.capacity_mw ? fmtMw(r.capacity_mw) : null, r.value_usd ? fmtUsd(r.value_usd) : null, r.term_years ? r.term_years + 'y' : null].filter(Boolean).join(' · ') || L('relation_types', r.relation_type);
    const text = label + (isNew ? ' · NEW' : ''); const tpos = sameCol ? .5 : (0.42 + (ei % 4) * 0.1); const bz = t => ({x: (1-t)*(1-t)*a.x + 2*(1-t)*t*cx + t*t*b.x, y: (1-t)*(1-t)*a.y + 2*(1-t)*t*cy + t*t*b.y}); const pt = bz(tpos); const lx = sameCol ? a.x + 70 : pt.x, ly = sameCol ? my : pt.y;
    let lx2 = lx, ly2 = ly; const pw0 = text.length * 6.2 + 14;
    // keep the pill clear of both endpoint boxes and of pills already placed
    nodes.forEach(q => { if (Math.abs(q.x - lx2) < 70 + pw0/2 && Math.abs(q.y - ly2) < 24) ly2 = q.y + (ly2 >= q.y ? 26 : -26); });
    placed.forEach(q => { if (Math.abs(q.x - lx2) < (q.w + pw0)/2 + 6 && Math.abs(q.y - ly2) < 20) ly2 = q.y + 22; });
    placed.push({x: lx2, y: ly2, w: pw0});
    const lg = labels.append('g').attr('transform', `translate(${lx2},${ly2})`).style('cursor', 'pointer');
    const pw = text.length * 6.2 + 14;
    lg.append('rect').attr('x', -pw/2).attr('y', -9).attr('width', pw).attr('height', 18).attr('rx', 9).attr('fill', '#0b1120').attr('fill-opacity', .97).attr('stroke', isNew ? 'var(--warn)' : '#3a4a78').attr('stroke-width', 1);
    lg.append('text').attr('text-anchor', 'middle').attr('dy', 3.5).attr('font-size', 10).attr('fill', isNew ? 'var(--warn)' : 'var(--fg)').attr('font-family', 'JetBrains Mono, monospace').text(text);
    const t = lg;
    t.on('mousemove', ev => showTip(ev, `<b>${esc(r.subject_name)}</b> ${esc(L('relation_types', r.relation_type))} <b>${esc(r.object_name)}</b><br>${label}<br><span style="color:var(--mute)">${esc(r.value_source || 'estimated')} · confidence ${Math.round((r.confidence||0)*100)}% · first seen ${esc((r.first_seen||'').slice(0,10))}</span>`)).on('mouseleave', hideTip).on('click', () => r.source_url && window.open(r.source_url, '_blank'));
  });
  nodes.forEach(n => { const g = nodesG.append('g').attr('transform', `translate(${n.x},${n.y})`).style('cursor', 'pointer').on('click', () => { if (byCompany[n.key]) { fE.value = n.key; fL.value = ''; fW.value = 'all'; renderFeed(); openDrawer(n.name); } });
    const wdt = Math.max(110, n.name.length * 7.5 + 28);
    g.append('rect').attr('x', -wdt/2).attr('y', -14).attr('width', wdt).attr('height', 28).attr('rx', 6).attr('fill', n.col === 0 ? 'url(#nodegrad)' : n.col === 1 ? '#15203a' : '#0b1120').attr('stroke', n.col === 2 ? 'var(--blue)' : n.col === 1 ? '#3a4a78' : 'none').attr('stroke-width', 1.5);
    g.append('text').attr('text-anchor', 'middle').attr('dy', 4).attr('font-size', 12).attr('font-weight', n.col === 0 ? 600 : 500).attr('fill', 'var(--fg)').attr('font-family', 'Inter, sans-serif').text(n.name); });
  document.getElementById('clist').innerHTML = rels.map(r => { const isNew = r.week_first === D.week; const lab = [r.capacity_mw ? fmtMw(r.capacity_mw) : null, r.value_usd ? fmtUsd(r.value_usd) : null, r.term_years ? r.term_years + 'y' : null].filter(Boolean).join(' · ');
    return `<div class="ci${isNew ? ' new' : ''}"><span><b>${esc(r.subject_name)}</b> ${esc(L('relation_types', r.relation_type))} <b>${esc(r.object_name)}</b></span><span class="mono" style="font-size:12px">${lab}</span><span class="cv">${r.relation_type === 'invests_in' ? 'investment' : 'power / supply'} · ${esc(r.value_source || 'estimated')}${isNew ? ' · <b>NEW</b>' : ''}${r.source_url ? ` · <a href="${esc(r.source_url)}" target="_blank" rel="noopener">source ↗</a>` : ''}</span></div>`; }).join('');
  const newest = D.relations.filter(r => r.week_first === D.week).sort((a,b)=>((b.value_usd||0)+(b.capacity_mw||0)*1e6)-((a.value_usd||0)+(a.capacity_mw||0)*1e6))[0];
  document.getElementById('fact5').textContent = newest ? `${newest.subject_name}–${newest.object_name} is new on the board this week${newest.mentions > 1 ? ', reported ' + newest.mentions + ' times' : ''}.` : `No new relations this week; ${rels.length} largest relations on record shown.`;
}
document.querySelectorAll('#circuits .chip').forEach(c => c.onclick = () => { document.querySelectorAll('#circuits .chip').forEach(x => x.classList.remove('on')); c.classList.add('on'); renderCircuits(c.dataset.rel); });
renderCircuits('all');

// ---- feed ----
const fL = document.getElementById('fL'), fT = document.getElementById('fT'), fE = document.getElementById('fE'), fI = document.getElementById('fI'), fW = document.getElementById('fW'), fQ = document.getElementById('fQ');
LAYERS.forEach(l => fL.insertAdjacentHTML('beforeend', `<option value="${l}">${esc(L('value_chain',l))}</option>`));
Object.keys(D.labels.signal_types).forEach(t => fT.insertAdjacentHTML('beforeend', `<option value="${t}">${esc(L('signal_types',t))}</option>`));
D.companies.slice().sort((a,b)=>a.name.localeCompare(b.name)).forEach(c => fE.insertAdjacentHTML('beforeend', `<option value="${c.slug}">${esc(c.name)}</option>`));
let feedLimit = 6;
let weekFilter = null;
function renderFeed(target){
  target = target || document.getElementById('feedtable');
  const q = fQ.value.trim().toLowerCase();
  const rows = D.signals.filter(s => (!weekFilter || target.id !== 'drawertable' || s.week === weekFilter) && (fW.value !== 'week' || weekIds.has(s.id)) && (!fL.value || s.value_chain === fL.value) && (!fT.value || s.signal_type === fT.value) && (!fE.value || (s.company_slugs||[]).includes(fE.value)) && (s.importance||1) >= +fI.value && (!q || (s.title + ' ' + (s.summary||'')).toLowerCase().includes(q)))
    .sort((a,b) => (b.date||'').localeCompare(a.date||'') || b.importance - a.importance);
  if (target.id === 'feedtable') document.getElementById('feedcount').textContent = `· showing ${Math.min(feedLimit, rows.length)} of ${rows.length}`;
  let html = '<tr><th>Date</th><th>' + T('Impact') + '</th><th>Signal</th><th>Layer</th><th>Type</th><th class="num">Figures</th><th>Source</th></tr>';
  if (!rows.length) html += '<tr><td colspan="7" style="color:var(--dim)">No signals match.</td></tr>';
  rows.slice(0, target.id === 'drawertable' ? 40 : feedLimit).forEach(s => {
    const figs = [s.capacity_mw ? fmtMw(s.capacity_mw) + (s.capacity_kind === 'it_load' ? ' load' : '') : null, s.deal_value_usd ? fmtUsd(s.deal_value_usd) : null].filter(Boolean).join(' · ') || '—';
    html += `<tr class="row" data-id="${s.id}"><td class="mono">${esc((s.date||'').slice(5))}</td><td>${imp(s.importance||1)}</td><td><b style="font-weight:600">${esc(s.title)}</b>${s.companies.length ? `<div style="font-size:11px;color:var(--mute)">${esc(s.companies.join(', '))}</div>` : ''}<div class="mtags"><span class="tag">${esc(SL(s.value_chain))}</span> <span class="tag">${esc(L('signal_types', s.signal_type))}</span> <span class="mono" style="color:var(--fg)">${figs}</span> · <a href="${esc(s.link)}" target="_blank" rel="noopener">${esc(s.source || 'source')} ↗</a></div></td><td><span class="tag">${esc(L('value_chain', s.value_chain))}</span></td><td><span class="tag">${esc(L('signal_types', s.signal_type))}</span></td><td class="num mono">${figs}</td><td><a href="${esc(s.link)}" target="_blank" rel="noopener">${esc(s.source || 'source')} ↗</a></td></tr>`;
    html += `<tr class="dt" data-for="${s.id}" style="display:none"><td colspan="7" class="detail">${esc(s.summary || '')}${s.location_name ? ` · <span class="mono">${esc(s.location_name)}${s.grid_region ? ' · ' + esc(s.grid_region) : ''}</span>` : ''}${s.project_stage ? ` · ${esc(s.project_stage)}` : ''}</td></tr>`;
  });
  const t = target; t.innerHTML = html;
  if (t.id === 'drawertable') { document.getElementById('dcount').textContent = `${rows.length} signal${rows.length===1?'':'s'}${weekFilter ? '' : ' · last 90 days'}`; return; }
  t.querySelectorAll('tr.row').forEach(r => r.onclick = ev => { if (ev.target.tagName === 'A') return; const d = t.querySelector(`tr.dt[data-for="${r.dataset.id}"]`); d.style.display = d.style.display === 'none' ? '' : 'none'; });
  const more = document.getElementById('feedmore');
  more.textContent = rows.length > feedLimit ? `▾ Show all ${rows.length} signals` : rows.length > 6 ? '▴ Show fewer' : '';
  more.onclick = () => { feedLimit = rows.length > feedLimit ? rows.length : 6; renderFeed(); };
}
[fL, fT, fE, fI, fW].forEach(el => el.onchange = () => { feedLimit = 6; renderFeed(); }); fQ.oninput = () => { feedLimit = 6; renderFeed(); };
renderFeed();

// ---- the panel ----
{ const weekBy = {}; sigWeek(D.week).forEach(s => (s.company_slugs||[]).forEach(k => weekBy[k] = (weekBy[k]||0) + 1));
  const hist = {}; D.companies.forEach(c => hist[c.slug] = WEEKS.map(w => sigWeek(w).filter(s => (s.company_slugs||[]).includes(c.slug)).length));
  const cards = D.companies.filter(c => c.status === 'active').sort((a,b) => (weekBy[b.slug]||0) - (weekBy[a.slug]||0) || (b.signal_count||0) - (a.signal_count||0));
  let cardLimit = 8;
  const renderCards = () => { document.getElementById('cards').innerHTML = cards.slice(0, cardLimit).map(c => { const h = hist[c.slug]; const mx = Math.max(1, ...h);
    return `<div class="card" data-slug="${c.slug}"><div class="nm"><span>${esc(c.name)}</span><span class="tag">${esc(L('entity_types', c.entity_type))}</span></div><div class="et mono">${esc(L('value_chain', c.value_chain))}${c.region ? ' · ' + esc(c.region) : ''}</div><div class="spark">${h.map((v,i) => `<i class="${i===WEEKS.length-1?'now':''}" style="height:${Math.max(2, 18*v/mx)}px" title="${WEEKS[i]}: ${v}"></i>`).join('')}</div><div class="et">${weekBy[c.slug]||0} this week · ${c.signal_count||0} in 90 days · ${c.relation_count||0} circuits</div></div>`; }).join('');
    document.querySelectorAll('.card').forEach(el => el.onclick = () => { fE.value = el.dataset.slug; fL.value = ''; fW.value = 'all'; feedLimit = 6; renderFeed(); openDrawer(byCompany[el.dataset.slug]?.name || 'Signals'); });
    const m = document.getElementById('cardsmore'); m.textContent = cards.length > cardLimit ? `▾ Show all ${cards.length} on the panel` : cards.length > 8 ? '▴ Show fewer' : ''; m.onclick = () => { cardLimit = cards.length > cardLimit ? cards.length : 8; renderCards(); }; };
  renderCards(); }
</script>
</body>
</html>
